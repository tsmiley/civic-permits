@page "/admin/permit-types/new"
@page "/admin/permit-types/{Id:guid}"
@attribute [Authorize(Roles = "Administrator")]
@inherits CivicPage

<PageTitle>@(HasProblems ? "Error: " : "")@Heading - Civic Permits</PageTitle>

<h1>@Heading</h1>

<p><a href="/admin/permit-types">Back to the list</a></p>

@if (Id is null || _type is not null)
{
    @if (Opened is not null)
    {
        <p class="notice" role="status">@Opened</p>
    }

    <ErrorSummary Problems="@Problems" />

    <form method="post" @formname="save" @onsubmit="SaveAsync" novalidate>
        <AntiforgeryToken />
        <SelectField Id="category" Label="Category" Required="true" Error="@ErrorFor("category")">
            <option value="">Choose a category</option>
            @foreach (string category in Categories)
            {
                <option value="@category" selected="@(Value("category", _type?.Category) == category)">@category</option>
            }
        </SelectField>
        <TextField Id="name" Label="Name" Required="true" Hint="3 to 80 characters. Each name is used once."
                   Value="@Value("name", _type?.Name)" Error="@ErrorFor("name")" MaxLength="80" />
        <TextAreaField Id="description" Label="Description" Required="true" Hint="10 to 500 characters, in plain words."
                       Value="@Value("description", _type?.Description)" Error="@ErrorFor("description")" MaxLength="500" />
        <TextField Id="fee" Label="Base fee, in dollars" Required="true" Hint="Charged whatever the project costs. For example 150 or 150.00."
                   Value="@Value("fee", _type is null ? null : (_type.BaseFeeCents / 100m).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))"
                   Error="@ErrorFor("fee")" Narrow="true" InputMode="decimal" />
        <TextField Id="rate" Label="Share of the project value, in percent" Required="true" Hint="Added to the base fee. 0 to 10, such as 1.25. Use 0 for a flat fee."
                   Value="@Value("rate", _type is null ? "0" : (_type.ValuationRateBasisPoints / 100m).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))"
                   Error="@ErrorFor("rate")" Narrow="true" InputMode="decimal" />
        <div class="field">
            <div class="choice">
                <input type="checkbox" id="inspection" name="inspection" value="yes" checked="@(IsPosted ? Posted("inspection") == "yes" : _type?.RequiresInspection == true)" />
                <label for="inspection">An inspection must pass before the permit is issued</label>
            </div>
        </div>
        <TextField Id="validity" Label="Days the permit stays valid" Required="true" Hint="30 to 3,650"
                   Value="@Value("validity", _type?.ValidityDays.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "365")" Error="@ErrorFor("validity")" Narrow="true" InputMode="numeric" />
        <TextField Id="review-days" Name="reviewDays" Label="Days the office aims to take to review" Required="true" Hint="1 to 90"
                   Value="@Value("reviewDays", _type?.TargetReviewDays.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "10")" Error="@ErrorFor("review-days")" Narrow="true" InputMode="numeric" />
        <button type="submit" class="button">@(Id is null ? "Add permit type" : "Save changes")</button>
    </form>

    @if (_type is not null)
    {
        <h2>Open or close</h2>
        <p>Applications already sent are not affected. Closing a permit only stops new applications for it.</p>
        @if (_type.IsActive)
        {
            <ActionForm FormName="close" Title="Close to new applications" ButtonText="Close this permit type" ButtonClass="button-secondary"
                        OnSubmit="@(() => SetActiveAsync(false))" />
        }
        else
        {
            <ActionForm FormName="open" Title="Open to new applications" ButtonText="Open this permit type"
                        OnSubmit="@(() => SetActiveAsync(true))" />
        }
    }
}

@code {
    private static readonly string[] Categories = ["Building", "Sign", "Event", "Vendor"];

    private PermitTypeResponse? _type;

    [Parameter]
    public Guid? Id { get; set; }

    [Parameter, SupplyParameterFromQuery]
    public string? Done { get; set; }

    private string Heading => Id is null ? "Add a permit type" : _type is null ? "Permit type" : $"Change {_type.Name}";

    private string? Opened => Done switch
    {
        "opened" => "The permit type is open to new applications.",
        "closed" => "The permit type is closed to new applications.",
        _ => null,
    };

    protected override async Task OnInitializedAsync()
    {
        if (Id is { } id)
        {
            _type = await LoadOrNotFoundAsync(() => Dispatcher.SendAsync(new CivicPermits.Application.Permits.GetPermitTypeQuery(id), Cancel));
        }
    }

    protected override string? FieldFor(string code) => code switch
    {
        "permit_type.category" => "category",
        "permit_type.name" or "permit_type.name_in_use" => "name",
        "permit_type.description" => "description",
        "permit_type.valuation_rate" => "rate",
        "permit_type.validity" => "validity",
        "permit_type.review_days" => "review-days",
        "money.negative" or "money.fraction_of_a_cent" => "fee",
        _ => base.FieldFor(code),
    };

    private string? Value(string field, string? saved) => IsPosted ? Posted(field) : saved;

    private async Task SaveAsync()
    {
        if (!Display.TryParseDollars(Posted("fee"), out long feeCents))
        {
            Problems.Add(new FormProblem("fee", "Enter the base fee in dollars, like 150 or 150.00."));
        }

        if (!Display.TryParsePercentToBasisPoints(Posted("rate"), out int basisPoints))
        {
            Problems.Add(new FormProblem("rate", "Enter a percentage from 0 to 10, like 1.25."));
        }

        if (!int.TryParse(Posted("validity"), System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out int validity))
        {
            Problems.Add(new FormProblem("validity", "Enter a whole number of days."));
        }

        if (!int.TryParse(Posted("reviewDays"), System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out int review))
        {
            Problems.Add(new FormProblem("review-days", "Enter a whole number of days."));
        }

        if (HasProblems)
        {
            return;
        }

        PermitTypeResponse? saved = await TryAsync(() => Dispatcher.SendAsync(
            new CivicPermits.Application.Permits.SavePermitTypeCommand(Id, new PermitTypeRequest(
                Posted("category"), Posted("name"), Posted("description"), feeCents, basisPoints, Posted("inspection") == "yes", validity, review)),
            Cancel));

        if (saved is not null)
        {
            Navigation.NavigateTo("/admin/permit-types?saved=true");
        }
    }

    private async Task SetActiveAsync(bool active)
    {
        PermitTypeResponse? changed = await TryAsync(
            () => Dispatcher.SendAsync(new CivicPermits.Application.Permits.SetPermitTypeActiveCommand(Id!.Value, active), Cancel));

        if (changed is not null)
        {
            Navigation.NavigateTo($"/admin/permit-types/{Id}?done={(active ? "opened" : "closed")}");
        }
    }
}
