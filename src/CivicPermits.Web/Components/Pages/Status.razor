@page "/status/{Code:int}"

<PageTitle>@Heading - Civic Permits</PageTitle>

<h1>@Heading</h1>

<p>@Explanation</p>
<p><a href="/">Go to the home page</a></p>

@code {
    [CascadingParameter]
    private HttpContext? Http { get; set; }

    [Parameter]
    public int Code { get; set; }

    private string Heading => Code switch
    {
        404 => "Page not found",
        403 => "You do not have access to this page",
        429 => "Too many requests",
        401 => "Please sign in",
        _ => "Something went wrong",
    };

    private string Explanation => Code switch
    {
        404 => "We could not find that page. Check the address, or start from the home page.",
        403 => "You are signed in, but your account does not have permission to see this page.",
        429 => "You are making requests too quickly. Wait a minute and try again.",
        401 => "You need to sign in to see that page.",
        _ => "The site could not do that. It has been logged. Please try again in a moment.",
    };
}
